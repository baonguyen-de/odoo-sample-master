<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="category_view_list" model="ir.ui.view">
        <field name="name">category_view_list</field>
        <field name="model">category</field>
        <field name="arch" type="xml">
            <list string="Category">
                <field name="code"/>
                <field name="name"/>
                <field name="description"/>
            </list>
        </field>
    </record>

    <record id="category_view_form" model="ir.ui.view">
        <field name="name">category_view_form</field>
        <field name="model">category</field>
        <field name="arch" type="xml">
            <form string="Category">
                <sheet>
                    <div class="oe_title">
                        <label for="code"/>
                        <h1>
                            <field name="code"/>
                        </h1>
                    </div>
                    <group>
                        <field name="name"/>
                        <field name="description"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="search_document_view" model="ir.ui.view">
        <field name="name">search_document_view</field>
        <field name="model">category</field>
        <field name="arch" type="xml">
            <search string="Document">
                <field name="name"/>
                <field name="code"/>
            </search>
        </field>
    </record>

    <record id="action_category_view" model="ir.actions.act_window">
        <field name="name">Category</field>
        <field name="res_model">category</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>